    "created_at": {
      "type": "string"
    },
    "packet": {
      "type": "object"
    },
    "hidden_context_summary": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "route_decision": {
      "type": "object"
    },
    "response": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "accepted_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejected_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission_control_write_result": {
      "type": [
        "object",
        "null"
