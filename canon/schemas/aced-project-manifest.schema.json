{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACED Project Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "privacy_default",
    "allowed_services",
    "blocked_services",
    "handoff_types"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "privacy_default": {
      "enum": [
        "green",
        "amber",
        "red"
      ]
    },
    "allowed_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "mission_control_project_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "chamber_entry": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
