{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jester-intelligence:schema:v1:app-manifest",
  "title": "Jester Intelligence App Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "appId",
    "name",
    "version",
    "status",
    "ownedStateKeys",
    "acceptedPacketTypes",
    "emittedPacketTypes",
    "engineDependencies",
    "capabilities",
    "requestedPermissions",
    "nativeRequirements",
    "entryPoints",
    "compatibility"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "description": "Version of this manifest contract used for compatibility checks." },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "description": "Stable app identifier; not a display name." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["scaffold", "planned", "active", "deprecated", "quarantined"], "description": "Manifest status; does not imply app readiness without evidence." },
    "ownedStateKeys": {
      "type": "array",
      "description": "Authoritative app-private state keys or namespaces owned by this app; replaces a separate storage-manifest schema.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "classification"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "enum": ["public", "internal", "personal", "sensitive", "secret"] },
          "description": { "type": "string" }
        }
      }
    },
    "acceptedPacketTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "emittedPacketTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "engineDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requestedPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "purpose", "access"],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "access": { "type": "string", "enum": ["read", "write", "read-write"] }
        }
      }
    },
    "nativeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresCapacitor", "packageId", "plugins"],
      "properties": {
        "requiresCapacitor": { "type": "boolean" },
        "packageId": { "type": ["string", "null"], "description": "One package ID per app when native packaging is selected." },
        "plugins": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "route"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreContracts"],
      "properties": {
        "coreContracts": { "type": "string", "description": "Accepted core-contract version or range required by this app." }
      }
    }
  }
}
