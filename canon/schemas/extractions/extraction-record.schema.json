{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jester-intelligence:schema:v1:extraction-record",
  "title": "Jester Intelligence Extraction Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extractionRecordId",
    "schemaVersion",
    "sourceRepository",
    "sourceCommit",
    "sourcePath",
    "sourceLineOrSymbol",
    "extractedObjectType",
    "targetPackage",
    "originalBehaviour",
    "dependencies",
    "userSpecificAssumptions",
    "knownDefects",
    "regressionFixtureRef",
    "provenanceStatus",
    "reviewer",
    "extractionDate",
    "rollbackOrSourceReference"
  ],
  "properties": {
    "extractionRecordId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "sourceRepository": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "sourceLineOrSymbol": { "type": "string", "minLength": 1 },
    "extractedObjectType": { "type": "string", "enum": ["function", "constant", "mapping", "dataset", "rule", "workflow", "ui-behaviour", "fixture", "asset", "configuration", "other"] },
    "extractedObjectSubtype": { "type": "string", "minLength": 1, "description": "Optional finer-grained label within the controlled extraction taxonomy." },
    "targetPackage": { "type": "string", "minLength": 1 },
    "originalBehaviour": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "userSpecificAssumptions": { "type": "array", "items": { "type": "string" }, "description": "Assumptions that must be removed or generalized before canonical extraction." },
    "knownDefects": { "type": "array", "items": { "type": "string" } },
    "regressionFixtureRef": { "type": "string" },
    "provenanceStatus": { "type": "string", "enum": ["accepted", "rejected", "replaced", "quarantined"] },
    "reviewer": { "type": "string" },
    "extractionDate": { "type": "string", "format": "date" },
    "rollbackOrSourceReference": { "type": "string" }
  }
}
