{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester-intelligence.netlify.app/schemas/app-config.schema.json",
  "title": "Jester Intelligence App Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "shortName",
    "theme",
    "branding",
    "manifest",
    "navigation",
    "android"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accentColor", "themeColor", "backgroundColor"],
      "properties": {
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "themeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLogo", "alt"],
      "properties": {
        "sourceLogo": {
          "type": "string",
          "pattern": "^(?!https?:|data:|/).+\\.png$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startUrl", "scope", "display", "orientation"],
      "properties": {
        "id": { "type": "string", "pattern": "^/[^?#]*$" },
        "startUrl": { "type": "string", "pattern": "^/[^?#]*$" },
        "scope": { "type": "string", "pattern": "^/[^?#]*/$" },
        "display": { "type": "string", "enum": ["standalone", "fullscreen", "minimal-ui"] },
        "orientation": { "type": "string", "enum": ["portrait", "any"] }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultChamber", "chambers"],
      "properties": {
        "defaultChamber": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "chambers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "packageId"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["undecided", "capacitor", "twa"]
        },
        "packageId": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": { "enum": ["capacitor", "twa"] }
            },
            "required": ["strategy"]
          },
          "then": {
            "properties": {
              "packageId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
              }
            }
          }
        }
      ]
    }
  }
}
